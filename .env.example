# Loaded by Make: use unquoted values, without 'export'.
IMAGE_NAME=eval-card-viz:latest
HOST_IP=127.0.0.1
HOST_PORT=8080
CONTAINER_PORT=80

# Space-separated Docker volume specifications (paths must not contain spaces).
# The app reads evaluation data from /deploy/aiq-evaluations.
# Example: /absolute/path/to/aiq-evaluations:/deploy/aiq-evaluations:ro
# Additional bind mounts may be appended, separated by spaces.
# Leave empty to use only the data already included in the image.
BIND_MOUNTS=./evaluations:/deploy/aiq-evaluations:ro
